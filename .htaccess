Options -Indexes

DirectoryIndex index.html

RewriteEngine On

# Force HTTPS
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Remove www
RewriteCond %{HTTP_HOST} ^www\.adjpcreative\.com [NC]
RewriteRule ^ https://adjpcreative.com%{REQUEST_URI} [L,R=301]

# Remove /index.html → /
RewriteCond %{THE_REQUEST} /index\.html[\s?] [NC]
RewriteRule ^(.*)index\.html$ /$1 [R=301,L]

# Remove .html from all other pages (e.g. /about.html → /about)
RewriteCond %{THE_REQUEST} \.html[\s?] [NC]
RewriteRule ^(.+)\.html$ /$1 [R=301,L]

# Internally serve .html files for clean URLs (e.g. /about → about.html)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+)$ $1.html [L]
